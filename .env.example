# ---- Supabase (valeurs locales affichées par `supabase start`, ou celles du projet de production)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement, JAMAIS exposée au navigateur

# ---- Emails (Resend)
RESEND_API_KEY=
EMAIL_FROM="Oummi RH <rh@votredomaine.re>"

# ---- Secrets des routes internes (générer avec : openssl rand -hex 32)
EVENTS_DISPATCH_SECRET=
CRON_SECRET=

# ---- Application
APP_URL=http://localhost:3000

# ---- Utilisés UNIQUEMENT par `npm run seed:employees` (création du compte admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
PLAYWRIGHT_CHROMIUM_PATH=            # optionnel : chemin d'un Chromium déjà installé (sinon npx playwright install chromium)
