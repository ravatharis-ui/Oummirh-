# ---- Supabase --------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT. Elle ignore toutes les règles de sécurité.
# Ne la collez jamais dans un message, un ticket ou un fichier suivi par Git.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Emails (Resend) — Phase 3 ---------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Oummi RH <rh@votredomaine.re>"

# ---- Secrets des routes internes — Phase 3 ---------------------------------
# Générer avec : openssl rand -hex 32
EVENTS_DISPATCH_SECRET=
CRON_SECRET=

# ---- Application -----------------------------------------------------------
APP_URL=http://localhost:3000

# ---- Sortie de secours de la politique de sécurité (CSP) — Phase 11 --------
# Mettre à 1 fait passer la CSP en simple observation : elle signale sans rien
# bloquer. À utiliser seulement si une page se retrouve vide après un
# déploiement, le temps de comprendre. Laisser vide en fonctionnement normal.
CSP_REPORT_ONLY=

# ---- Utilisés UNIQUEMENT par `npm run seed:employees` — Phase 2 ------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Tests (optionnel) -----------------------------------------------------
# Chemin d'un Chromium déjà installé, sinon : npx playwright install chromium
PLAYWRIGHT_CHROMIUM_PATH=

# ---- Création des comptes — utilisés par `npm run seed:employees` (Phase 2)
# Écrire les codes PIN générés dans seed-output/pins.csv. Désactivé par défaut :
# la direction obtient chaque code depuis /admin/collaboratrices, affiché une fois.
WRITE_PINS_CSV=
